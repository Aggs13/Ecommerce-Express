<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles/Detalle.css">
  <title><%= producto.nombre %></title>
</head>
<body>
  <%- include("../partial/header", {titulo:"Inicio", page:"inicio"}) %>

  <main class="detalle">
    <a class="volver" href="/inicio">Volver al Inicio</a>

    <section class="detalle-producto">
      <div class="detalle-imagen">
        <img src="<%= producto.linkImg %>" alt="<%= producto.nombre %>">
      </div>

      <div class="detalle-info">
        <h1><%= producto.nombre %></h1>
        <p class="precio"><%= producto.precio %> <span>puntos</span></p>

        <a class="boton-carrito" href="/agregar-carrito/<%= producto.id %>">
          Agregar al Carrito
        </a>

        <h2>Descripcion</h2>
        <p class="descripcion"><%= producto.descripcion %></p>
        <p class="categoria"><strong>Categoria:</strong> <%= producto.categoria %></p>
      </div>
    </section>

    <section class="sugeridos">
      <h2>Tambien te puede interesar</h2>

      <div class="sugeridos-grid">
        <% productosSugeridos.forEach(p => { %>
          <a class="producto-card" href="/Detalles/<%= p.id %>">
            <img src="<%= p.linkImg %>" alt="<%= p.nombre %>">
            <div class="producto-card-info">
              <p><%= p.nombre %></p>
              <h3>$<%= p.precio %></h3>
            </div>
          </a>
        <% }) %>
      </div>
    </section>
  </main>
</body>
</html>
