<section class="Producto">
    <h2>Productos</h2>

    <div class="orden-productos">
        <% if (typeof orden === "undefined" || !orden) { %>
            <a href="/Productos?orden=asc<%= categoria ? '&categoria=' + encodeURIComponent(categoria) : '' %>">
                <button type="button">Ordenar asc <i class="fa-solid fa-angles-up"></i></button>
            </a>
            <a href="/Productos?orden=desc<%= categoria ? '&categoria=' + encodeURIComponent(categoria) : '' %>">
                <button type="button">Ordenar des <i class="fa-solid fa-angles-down"></i></button>
            </a>
        <% } else if (orden === "asc") { %>
            <a href="/Productos?orden=desc<%= categoria ? '&categoria=' + encodeURIComponent(categoria) : '' %>">
                <button type="button">Ordenar des <i class="fa-solid fa-angles-down"></i></button>
            </a>
            <a href="/Productos<%= categoria ? '?categoria=' + encodeURIComponent(categoria) : '' %>">
                <button type="button">Borra Filtro <i class="fa-solid fa-angle-left"></i></button>
            </a>
        <% } else if (orden === "desc") { %>
            <a href="/Productos?orden=asc<%= categoria ? '&categoria=' + encodeURIComponent(categoria) : '' %>">
                <button type="button">Ordenar asc <i class="fa-solid fa-angles-up"></i></button>
            </a>
            <a href="/Productos<%= categoria ? '?categoria=' + encodeURIComponent(categoria) : '' %>">
                <button type="button">Borra Filtro <i class="fa-solid fa-angle-left"></i></button>
            </a>
        <% } %>

        <form action="/Productos" method="GET">
            <% if (typeof orden !== "undefined" && orden) { %>
                <input type="hidden" name="orden" value="<%= orden %>">
            <% } %>

            <select name="categoria">
                <option value="" <%= !categoria ? "selected" : "" %>>Todos</option>
                <option value="Snack Salado" <%= categoria === "Snack Salado" ? "selected" : "" %>>Snack Salado</option>
                <option value="Chocolate" <%= categoria === "Chocolate" ? "selected" : "" %>>Chocolate</option>
                <option value="Galletas" <%= categoria === "Galletas" ? "selected" : "" %>>Galletas</option>
                <option value="Bebida" <%= categoria === "Bebida" ? "selected" : "" %>>Bebida</option>
            </select>

            <button type="submit">Buscar</button>
        </form>
    </div>

    <div class="grid">
        <% if (productos.length == 0) { %>
            <p>No hay productos disponibles</p>
        <% } else { %>
            <% productos.forEach(p => { %>
                <a href="/Detalles/<%= p.id %>">
                    <article>
                        <img src="<%= p.img %>" alt="<%= p.nombre %>">
                        <p><%= p.nombre %></p>
                        <h4>$<%= p.precio %></h4>
                    </article>
                </a>
            <% }) %>
        <% } %>
    </div>
</section>
