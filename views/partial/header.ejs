<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="stylesheet" href="/styles/Header.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<title><%= titulo %></title>

<header class="main-header">
  <div class="header-container">
    <!-- Logo -->
    <a href="/inicio" class="logo">
      <span class="logo-mi">Mi</span><span class="logo-ecommerce">Ecommerce</span>
    </a>
    
    <% if (page === 'inicio') { %>
      <!-- Buscador solo en inicio -->
      <div class="search-bar">
        <input 
          type="text" 
          class="search-input" 
          placeholder="Buscar productos..." 
        />
        <button type="button" class="search-button">
          <i class="fas fa-search"></i>
        </button>
      </div>
      
      <!-- Iconos de carrito y perfil solo en inicio -->
      <div class="header-icons">
        <!-- Carrito -->
        <a href="/Carrito" class="icon-button cart-button">
          <i class="fas fa-shopping-cart"></i>
          <span class="cart-badge">0</span>
        </a>
        
        <!-- Usuario -->
        <a href="/perfil" class="icon-button user-button">
          <div class="user-avatar">O</div>
          <span class="user-name">Olivia</span>
        </a>
      </div>
    <% } %>
  </div>
</header>
