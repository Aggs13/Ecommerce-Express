<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/inicio.css">
    <title>Inicio</title>
</head>
<body>
    <%- include("../partial/header", {titulo:"Login", buscador:true}) %>
    <br>
    
    <%- include("../partial/categorias") %>

    <section class="Promocion">
        <div class="Publicidad">
            <p>50% OFF en Combo Plus <br> Canjeando 50.000 puntos <br> MiEcommerce</p>
        </div>

        <div class="Publicidad">
            <p>50% OFF en HBO Max <br> Canjeando 50.000 puntos <br> MiEcommerce</p>
        </div>
    </section>
    
    <section class="Producto">
    <h2>Te puede interesar</h2>

        <div class="grid">

            <% productos.slice(4,8).forEach(p => { %>
              <article><a href="/Detalles"><%= p.nombre %></a></article>
            <% }) %>
        </div>
    </section>
    
    <section class="Producto">
    <h2>Los más pedidos</h2>
        <div class="grid">
          <% productos.slice(0,8).forEach(p => { %>
            <article><a href=""><%= p.nombre %></a></article>
         <% }) %>
        </div>
    </section>
    <%- include("../partial/categorias") %>
</body>
</html>