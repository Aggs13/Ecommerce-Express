<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/Carrito.css">
    <title>Carrito</title>
</head>
<body>
    <%- include("./partials/header", {titulo:"Inicio", page:"inicio",usuario:"usuario"}) %>
    
    <section>
        <a href="/Inicio"><i class="fa-solid fa-arrow-left"></i> volver</a>
        <h2>Productos en tu Carrito</h2>
        <div class="contenedor-carrito">

            <% if(carrito.length == 0){%>
                <h3>Tu Carrito está vacío</h3>
                <p>Agrega productos para comenzar tu compra</p>

                <div class="inicio">
                <a href="/inicio">
                    <button class="boton-quitar">Volver al Inicio</button>
                </a>
                </div>

            <%} else {%>  
               


            <% carrito.forEach(p => { %>
                <article>
                    <img src="<%= p.img %>" alt="<%= p.nombre %>" >
                    <p><%= p.nombre %></p>
                    

                    <div class="contador">
                        <a href="/sacar-carrito/<%= p.idP %>">
                        <button class="boton-quitar">Quitar</button>
                        </a>
                        
                        <a href="/eliminar-carrito/<%= p.idP %>">
                            <button>-</button>
                        </a>

                        <span class="cantidad"><%= p.cantidad %></span>
                        
                        <a href="/sumar-carrito/<%= p.idP %>">
                            <button>+</button>
                        </a>
                        <h4>$<%= p.precio %></h4>
                    </div>
                </article>    
            <% }) %>
            <h2 class="total">Total: $<%= total %></h2>
            <div class="contenedor-pago">
                <button class="boton-pago">Ir a Pagar</button>
            </div>
        </div>
       <% } %>  

    </section>
</body>
</html>