<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/inicio.css">
    <title>Inicio</title>
</head>
<body>
    <%- include("../partial/header", {titulo:"Inicio", page:"inicio"}) %>
    <br>
    
    <%- include("../partial/categorias") %>

    <section class="Promocion">
        <div class="Publicidad">
            <p>50% OFF en Combo Plus <br> Canjeando 50.000 puntos <br> MiEcommerce</p>
        </div>

        <div class="Publicidad">
            <p>50% OFF en HBO Max <br> Canjeando 50.000 puntos <br> MiEcommerce</p>
        </div>
    </section>
    
    <section class="Producto">
    <h2>Te puede interesar</h2>

        <div class="grid">

          <% productos.slice(7,11).forEach(p => { %>
            <a href="/Detalles">

              <article>
                <img src="<%= p.linkImg%>" alt="<%= p.nombre %>" >
                <h4><%= p.nombre %></h4>
                <h4>$<%= p.precio %></h4>
              </article>
            </a>
          <% }) %>
        </div>
    </section>
    
    <section class="Producto">
    <h2>Los más pedidos</h2>
        <div class="grid">
          <% productos.slice(0,8).forEach(p => { %>
            <article>
              <img src="<%= p.linkImg%>" alt="<%= p.nombre %>" >
              <a href=""><%= p.nombre %></a>
              <h4>$<%= p.precio %></h4>
            </article>
         <% }) %>
        </div>
    </section>
    <%- include("../partial/categorias") %>
</body>
</html>
