<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles/Login.css">
  <title>Registrarse</title>
</head>
<body>
  

  <%- include("./partials/header", {titulo:"Registrarse", page:"registro"}) %>
  <form action="/registro" method="POST">

    <h1>¡Registrate!</h1>

    <input type="text" name="nombre" placeholder="Tu  nombre">
    <br>

    <input type="text" name="apellido" placeholder="Tu apellido">
    <br>

    <input type="email" name="email" placeholder="Tu email">
    <br>
    
    <input type="password" name="password" placeholder="Tu nueva contraseña">
    <br>

    
    <input type="password" name="repetirPassword" placeholder="Repite tu contraseña">
    <br>
    <br>
    <button type="submit">Registrarse</button>
    <br>

    <p>¿Ya tienes cuenta? <a href="/">Inicia Sesion</a></p>

  </form>
</body>
</html>
