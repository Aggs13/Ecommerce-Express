
<section class="Producto">
    <h2>Productos</h2>

    <div class="orden-productos">
        <% if (typeof orden === "undefined" || !orden) { %>
            <a href="/Productos?orden=asc">
                <button type="button">Ordenar asc <i class="fa-solid fa-angles-up"></i></button>
            </a>
            <a href="/Productos?orden=desc">
                <button type="button">Ordenar des <i class="fa-solid fa-angles-down"></i></button>
            </a>
        <% } else if (orden === "asc") { %>
            <a href="/Productos?orden=desc">
                <button type="button">Ordenar des <i class="fa-solid fa-angles-down"></i></button>
            </a>
            <a href="/Productos">
                <button type="button">Borra Filtro <i class="fa-solid fa-angle-left"></i></button>
            </a>
        <% } else if (orden === "desc") { %>
            <a href="/Productos?orden=asc">
                <button type="button">Ordenar asc <i class="fa-solid fa-angles-up"></i></button>
            </a>

            <a href="/Productos">
                <button type="button">Borra Filtro <i class="fa-solid fa-angle-left"></i></button>
            </a>
        <% } %>
        <form action="/Categorias" method="GET">

            <select name="categoria">
            <option value="">Todos</option>
            <option value="Snack Salado">Snack Salado</option>
            <option value="Chocolate">Chocolate</option>
            <option value="Galletas">Galletas</option>
            <option value="Bebida">Bebida</option>
            </select>

        <button type="submit">Buscar</button>
      </form>
    </div>

    <div class="grid">
        <% if(productos.length == 0){ %>
            <p>No hay productos disponibles</p>
        <%}else{%>
            <% productos.forEach(p => { %>
                <a href="/Detalles/<%= p.idP%>">
                    <article>
                        <img src="<%= p.img %>" alt="<%= p.nombre %>">
                        <p><%= p.nombre %></p>
                        <h4>$<%= p.precio %></h4>
                    </article>
                </a>
            <% }) %>
        <%}%>
    </div>
</section>
