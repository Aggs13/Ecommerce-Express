<section class="detalle">
  <a class="volver" href="/inicio"><i class="fa-solid fa-arrow-left"></i> Volver al Inicio</a>
  <section class="detalle-card">
    <div class="detalle-imagen">
      <img src="<%= producto.img %>" alt="<%= producto.nombre %>">
    </div>

    <div class="detalle-info">
      <h1><%= producto.nombre %></h1>
      <p class="puntos"><strong>19.900 puntos</strong></p>

      <h2>Descripcion</h2>
      <p><%= producto.descripcion %></p>

      <p><strong>Categoria:</strong> <%= producto.categoria %></p>
      <% if(stockSuficiente){ %>
        <form action="/agregar-carrito/<%= producto.idP %>" method="POST">
          <button type="submit">Agregar al Carrito</button>
        </form>

      <% }else{ %>
        <p>No hay stock</p>
      <% } %>
    </div>
  </section>

  
<section class="Producto">
<h2>Te puede interesar</h2>

    <div class="grid">
      <% if (!productosRelacionados || productosRelacionados.length == 0) { %>
        <p>No hay productos relacionados disponibles</p>
      <% } else { %>
        <% productosRelacionados.forEach(p => { %>
          <a href="/Detalles/<%= p.idP %>">
            <article>
              <img src="<%= p.img %>" alt="<%= p.nombre %>">
              <p><%= p.nombre %></p>
              <h4>$<%= p.precio %></h4>
            </article>
          </a>
        <% }) %>
      <% } %>
    </div>
</section>


</section>
<%- include("./partials/categorias") %>
